# ========================================================
# Smart Health Database — Environment Variables
# Copy this file to .env and fill in your credentials.
# Used by: seed.py, db.py in the database/ directory
# ========================================================

# PostgreSQL Connection (Supabase Pooler — Transaction Mode)
# Found in: Supabase Dashboard → Settings → Database → Connection string → URI
# ⚠️  NEVER commit real credentials. Replace the placeholder below.
DATABASE_URL=postgresql://YOUR_USER:YOUR_PASSWORD@YOUR_HOST:6543/YOUR_DB?sslmode=require

# Direct Connection (for schema migrations — bypasses pooler)
DIRECT_DATABASE_URL=postgresql://YOUR_USER:YOUR_PASSWORD@YOUR_HOST:5432/YOUR_DB?sslmode=require
