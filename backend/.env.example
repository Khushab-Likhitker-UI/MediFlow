# ========================================================
# Smart Health Backend — Environment Variables
# Copy this file to .env and fill in your credentials.
# ========================================================

# PostgreSQL Connection (Supabase Pooler — Transaction Mode)
# Found in: Supabase Dashboard → Settings → Database → Connection string → URI
# ⚠️  NEVER commit real credentials. Replace the placeholder below.
DATABASE_URL=postgresql://YOUR_USER:YOUR_PASSWORD@YOUR_HOST:6543/YOUR_DB?sslmode=require

# Application metadata
APP_NAME=Healthcare Supply Chain API
APP_VERSION=0.1.0

# Debug mode (true/false) — defaults to false outside explicit local debugging
DEBUG=false

# Comma-separated CORS allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174,http://127.0.0.1:3000,http://127.0.0.1:5173
