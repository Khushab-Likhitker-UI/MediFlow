# ==============================================================================
# Smart Health Sentinel (MediFlow) — Environment Configuration Template
# Copy this file to .env and configure values. NEVER commit real secrets to git.
# In Google Cloud Run, bind secrets from Google Secret Manager.
# ==============================================================================

# Database Connection (PostgreSQL connection URI with SSL)
# Cloud Run / Supabase Pooler URI format:
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DB?sslmode=require

# Application Metadata & Runtime
APP_NAME=Healthcare Supply Chain API
APP_VERSION=0.1.0
PORT=8080

# Operational Debug Mode (Must be 'false' in deployed production environments)
DEBUG=false

# Allowed Frontend Origins (Comma-separated exact HTTPS origins, no wildcard '*')
CORS_ORIGINS=https://smart-health-gray-theta.vercel.app,https://smarthealth-production.up.railway.app,http://localhost:3000,http://localhost:5173,http://localhost:5174

# JWT Cryptographic Authentication (Generate min 32-char high-entropy secret)
JWT_SECRET_KEY=REPLACE_WITH_SECURE_RANDOM_SECRET_KEY_MIN_32_CHARS
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Supply Chain Policy Defaults
PLANNING_HORIZON_DAYS=30
SAFETY_RESERVE_DAYS=7

# Google Gemini / Vertex AI Configuration (Optional operational explanation service)
# If omitted or unavailable, the backend automatically uses deterministic template fallback.
# Never expose this key to client code or mobile PWAs.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
GEMINI_TIMEOUT_SECONDS=3.0
